
{
    "label": "logout",
    "action": "niri msg action quit",
    "text": "Выйти из сессии",
    "keybind": "e"
}

{
    "label": "suspend",
    "action": "systemctl suspend",
    "text": "Режим ожидания",
    "keybind": "u"
}

{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Выключить",
    "keybind": "s"
}


{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Перезагрузить",
    "keybind": "r"
}
